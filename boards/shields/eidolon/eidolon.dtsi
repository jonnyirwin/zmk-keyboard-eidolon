/*
 * Copyright (c) 2026 Jonny Irwin
 * SPDX-License-Identifier: MIT
 *
 * Wiring (mirrored boards, but each half is an independent wireless unit
 * with its own net->pin map -- the maps differ between halves):
 *   cols C0-C4 (pinky..inner) -> XIAO D0-D4   (both halves)
 *   LEFT  rows R0,R1,R2,R3 (top/home/bottom/thumb) -> D5, D6, D8, D7
 *   RIGHT rows R0,R1,R2,R3                          -> D10, D9, D8, D7
 *   COL2ROW diodes.
 *
 * This dtsi defines the LEFT row mapping in kscan0; the right overlay
 * overrides row-gpios to match the right board.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "eidolon-layouts.dtsi"

&physical_layout0 {
    kscan = <&kscan0>;
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        // Right half is a mirrored board, so its columns run inner..pinky
        // when read left-to-right; col-offset = <5> is set in the right overlay.
        map = <
                RC(0,1) RC(0,2) RC(0,3)                 RC(0,8) RC(0,7) RC(0,6)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
                        RC(3,3) RC(3,4) RC(3,9) RC(3,8)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";

        col-gpios
            = <&xiao_d 0 GPIO_ACTIVE_HIGH>
            , <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>
            ;

        // LEFT half: R0,R1,R2,R3 -> D5, D6, D8, D7 (right overlay overrides this)
        row-gpios
            = <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
