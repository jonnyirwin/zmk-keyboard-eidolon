/*
 * Copyright (c) 2026 Jonny Irwin
 * SPDX-License-Identifier: MIT
 *
 * Default keymap adapted from the ZMK hummingbird shield (same 30-key column
 * structure: 2-key pinky and inner columns, 3-key ring/middle/index, 2 thumbs
 * per half). Letters map 1:1 by column; Z, B, Y and / are combos on the
 * bottom row, as on the hummingbird. BLE profile controls added on the nav
 * layer's left half.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF_L 0
#define NAV_L 1
#define NUM_L 2
#define SYM_L 3

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace
&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <225>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_z {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kp Z>;
        };
        combo_b {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp B>;
        };

        combo_y {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp Y>;
        };

        combo_slash {
            timeout-ms = <50>;
            key-positions = <23 24>;
            bindings = <&kp SLASH>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
                           &kp W      &kp E       &kp R                        &kp U       &kp I       &kp O
                &kp Q      &hm LALT S &hm LCTRL D &hm LSHFT F   &kp T  &kp H   &hm RSHFT J &hm RCTRL K &hm LALT L &kp P
                &hm LGUI A &kp X      &kp C       &kp V         &kp G  &kp N   &kp M       &kp COMMA   &kp DOT    &hm RGUI SQT
                                                  &lt NAV_L TAB &kp RET       &lt NUM_L SPACE &lt SYM_L BSPC
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                            &trans       &trans       &trans                          &kp HOME &kp UP   &kp PG_UP
                &trans      &trans       &trans       &trans       &trans   &trans   &kp LEFT &kp DOWN &kp RIGHT &studio_unlock
                &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &out OUT_TOG &trans &kp END &trans  &kp PG_DN &trans
                                                      &trans       &trans   &kp ESC  &kp DEL
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                           &kp N7     &kp N8      &kp N9                          &trans   &trans   &trans
                &kp LBKT   &kp N4     &kp N5      &kp N6        &kp RBKT &trans   &trans   &trans   &trans   &trans
                &kp SEMI   &kp N1     &kp N2      &kp N3        &kp EQUAL &trans  &trans   &trans   &trans   &trans
                                                  &kp N0        &kp MINUS &trans  &trans
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
                           &kp LS(N7) &kp LS(N8)  &kp LS(N9)                       &trans   &trans   &trans
                &kp LBRC   &kp LS(N4) &kp LS(N5)  &kp LS(N6)    &kp RBRC &trans    &trans   &trans   &trans   &trans
                &kp COLON  &kp LS(N1) &kp LS(N2)  &kp LS(N3)    &kp PLUS &trans    &trans   &trans   &trans   &trans
                                                  &kp LS(N0)    &kp UNDER &trans   &trans
            >;
        };
    };
};
